# Formatting is manual/IDE here — prettier is deliberately not run (see CLAUDE.md). This is the
# minimum that stops editors disagreeing about invisible characters.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false
