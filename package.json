{
  "name": "anchor",
  "version": "0.1.0",
  "private": true,
  "description": "An alarm you cannot dismiss from bed, at either end of the night.",
  "author": "Oscar Norris",
  "license": "UNLICENSED",
  "main": "expo-router/entry",
  "scripts": {
    "dev": "expo start --dev-client",
    "dev:ios": "expo start --dev-client --ios",
    "dev:android": "expo start --dev-client --android",
    "dev:clear": "expo start --dev-client --clear",
    "build:ios": "expo run:ios",
    "build:android": "expo run:android",
    "build:ios:device": "expo run:ios --device",
    "native:regenerate": "expo prebuild --clean",
    "check:code": "node ./scripts/check-code.mjs",
    "check:rules": "node ./scripts/check-house-rules.mjs",
    "lint": "expo lint",
    "lint:fix": "expo lint --fix",
    "type-check": "tsc -p tsconfig.check.json --noEmit",
    "test": "vitest --run",
    "test:watch": "vitest",
    "doctor": "npx expo-doctor",
    "db:generate": "drizzle-kit generate",
    "docs:progress": "node ./scripts/gen-progress.mjs",
    "docs:progress:check": "node ./scripts/gen-progress.mjs --check",
    "help": "node ./scripts/help.mjs"
  },
  "dependencies": {
    "@expo/ui": "~57.0.11",
    "drizzle-orm": "^0.45.2",
    "drizzle-zod": "^0.8.3",
    "expo": "~57.0.13",
    "expo-constants": "~57.0.11",
    "expo-dev-client": "~57.0.12",
    "expo-device": "~57.0.1",
    "expo-font": "~57.0.1",
    "expo-glass-effect": "~57.0.1",
    "expo-image": "~57.0.3",
    "expo-linking": "~57.0.6",
    "expo-router": "~57.0.13",
    "expo-splash-screen": "~57.0.6",
    "expo-sqlite": "~57.0.1",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.2",
    "expo-system-ui": "~57.0.2",
    "expo-web-browser": "~57.0.2",
    "nativewind": "^5.0.0-preview.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-css": "^3.0.7",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/react": "~19.2.2",
    "babel-plugin-inline-import": "^3.0.0",
    "better-sqlite3": "^13.0.3",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.1",
    "postcss": "^8.5.26",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "lightningcss": "1.30.1"
  },
  "engines": {
    "node": ">=22.12"
  }
}
